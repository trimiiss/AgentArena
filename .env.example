# Local development only. Copy to .env, or let Compose read this file directly.
# Every value below is a placeholder that is safe to publish. It protects nothing.
# Real deployments generate their own values: see scripts/deploy-kind.sh.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. One superuser for bootstrap, then one role per service database.
POSTGRES_PASSWORD=local-dev-postgres
IDENTITY_DB_PASSWORD=local-dev-identity
AGENTS_DB_PASSWORD=local-dev-agents
SCENARIOS_DB_PASSWORD=local-dev-scenarios
RUNS_DB_PASSWORD=local-dev-runs
EVALUATIONS_DB_PASSWORD=local-dev-evaluations

# RabbitMQ. The default guest account stays disabled for remote connections.
RABBITMQ_USER=agentarena
RABBITMQ_PASSWORD=local-dev-rabbitmq

# Shared secret for /internal routes between services.
INTERNAL_SERVICE_TOKEN=local-dev-internal-token

# 32 random bytes, base64-encoded. Generate real ones with: openssl rand -base64 32
IDENTITY_KEY_ENCRYPTION_KEY=bG9jYWwtZGV2LWlkZW50aXR5LWtleS0wMDAwMDAwMDA=
CREDENTIALS_ENCRYPTION_KEY=bG9jYWwtZGV2LWNyZWRlbnRpYWxzLWtleS0wMDAwMDA=

# Grafana administrator.
GRAFANA_ADMIN_PASSWORD=local-dev-grafana

# Token the bundled sample agent expects on /agents/secure.
SAMPLE_AGENT_API_KEY=local-dev-sample-agent

# Optional. Enables the advisory LLM judge. Leave empty to run without it.
ANTHROPIC_API_KEY=

# Account created by scripts/seed_demo.py.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=local-dev-demo-password
