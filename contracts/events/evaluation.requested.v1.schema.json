{
  "$defs": {
    "ExecutionMetrics": {
      "properties": {
        "agent_calls": {
          "default": 0,
          "title": "Agent Calls",
          "type": "integer"
        },
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "queue_wait_ms": {
          "default": 0,
          "title": "Queue Wait Ms",
          "type": "number"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "ExecutionMetrics",
      "type": "object"
    },
    "TranscriptStep": {
      "description": "One recorded interaction inside an execution.",
      "properties": {
        "arguments": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arguments"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "injected_failure": {
          "default": false,
          "title": "Injected Failure",
          "type": "boolean"
        },
        "is_error": {
          "default": false,
          "title": "Is Error",
          "type": "boolean"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "output": {
          "default": null,
          "title": "Output"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "structured_output": {
          "default": null,
          "title": "Structured Output"
        },
        "task_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Status"
        },
        "type": {
          "enum": [
            "user_message",
            "agent_response",
            "tool_call",
            "tool_result",
            "error"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "type"
      ],
      "title": "TranscriptStep",
      "type": "object"
    }
  },
  "description": "Everything the evaluator needs, so it never reads another service's data.",
  "properties": {
    "agent_id": {
      "format": "uuid",
      "title": "Agent Id",
      "type": "string"
    },
    "agent_name": {
      "default": "",
      "title": "Agent Name",
      "type": "string"
    },
    "agent_version": {
      "title": "Agent Version",
      "type": "integer"
    },
    "criteria": {
      "additionalProperties": true,
      "title": "Criteria",
      "type": "object"
    },
    "difficulty": {
      "title": "Difficulty",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "execution_id": {
      "format": "uuid",
      "title": "Execution Id",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed",
        "timed_out",
        "cancelled"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "expected": {
      "additionalProperties": true,
      "title": "Expected",
      "type": "object"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "judge_enabled": {
      "default": false,
      "title": "Judge Enabled",
      "type": "boolean"
    },
    "metrics": {
      "$ref": "#/$defs/ExecutionMetrics"
    },
    "repetition": {
      "title": "Repetition",
      "type": "integer"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "run_name": {
      "default": "",
      "title": "Run Name",
      "type": "string"
    },
    "scenario_id": {
      "format": "uuid",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_name": {
      "title": "Scenario Name",
      "type": "string"
    },
    "scenario_type": {
      "title": "Scenario Type",
      "type": "string"
    },
    "scenario_version": {
      "title": "Scenario Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "transcript": {
      "items": {
        "$ref": "#/$defs/TranscriptStep"
      },
      "title": "Transcript",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "execution_id",
    "agent_id",
    "agent_version",
    "scenario_id",
    "scenario_version",
    "scenario_name",
    "scenario_type",
    "difficulty",
    "repetition",
    "seed",
    "execution_status"
  ],
  "title": "EvaluationRequested",
  "type": "object"
}
