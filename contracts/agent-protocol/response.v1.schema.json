{
  "$defs": {
    "AgentMessage": {
      "properties": {
        "content": {
          "default": "",
          "title": "Content",
          "type": "string"
        },
        "role": {
          "const": "assistant",
          "default": "assistant",
          "title": "Role",
          "type": "string"
        }
      },
      "title": "AgentMessage",
      "type": "object"
    },
    "ToolCall": {
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Usage": {
      "description": "Reported by the agent. AgentArena cannot observe tokens on its own.",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "properties": {
    "message": {
      "$ref": "#/$defs/AgentMessage"
    },
    "protocol_version": {
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "structured_output": {
      "default": null,
      "title": "Structured Output"
    },
    "task_status": {
      "default": "completed",
      "enum": [
        "in_progress",
        "completed",
        "failed",
        "needs_input"
      ],
      "title": "Task Status",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "AgentResponse",
  "type": "object"
}
