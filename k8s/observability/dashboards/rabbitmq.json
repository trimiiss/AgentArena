        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event_type) (rate(events_published_total[1m]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
