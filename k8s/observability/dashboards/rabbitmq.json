      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(event_handler_duration_seconds_bucket[1m])))",
          "legendFormat": "{{queue}}",
          "refId": "A"
